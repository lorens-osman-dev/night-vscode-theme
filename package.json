{
  "name": "night",
  "displayName": "Night",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Night Vali",
        "uiTheme": "vs-dark",
        "path": "./themes/night-vali-theme.json"
      },
      {
        "label": "Night Shift",
        "uiTheme": "vs-dark",
        "path": "./themes/night-shift-theme.json"
      },
      {
        "label": "Night Glass",
        "uiTheme": "vs-dark",
        "path": "./themes/night-glass-theme.json"
      },
      {
        "label": "Night Glass2",
        "uiTheme": "vs-dark",
        "path": "./themes/night-glass2-theme.json"
      }
    ]
  },
  "dependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/vscode": "^1.98.0",
    "color": "^5.0.0",
    "husky": "^9.1.7",
    "vsce": "^2.15.0"
  },
  "scripts": {
    "watch": "bun --watch src/*",
    "update-color-keys": "bun run scripts/generateVscodeColorKeys.ts",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "prepare": "husky",
    "vsce": "bun run src/index.ts && vsce package"
  }
}
